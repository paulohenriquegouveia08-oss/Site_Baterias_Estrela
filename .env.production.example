# ==============================================================================
# Baterias Estrela - Variáveis de Ambiente de Produção (VPS)
# Copie este arquivo para .env.production na raiz da sua VPS:
#   cp .env.production.example .env.production
# ==============================================================================

# Ambiente e Porta
NODE_ENV=production
PORT=3333
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Banco de Dados PostgreSQL (Produção)
# ------------------------------------------------------------------------------
POSTGRES_DB=baterias_estrela
POSTGRES_USER=estrela_admin
# GERE UMA SENHA FORTE (ex: openssl rand -base64 24)
POSTGRES_PASSWORD=defina_uma_senha_muito_forte_aqui_123456

# String de conexão usada pela aplicação internamente na rede Docker
DATABASE_URL=postgresql://estrela_admin:defina_uma_senha_muito_forte_aqui_123456@postgres:5432/baterias_estrela?schema=public

# ------------------------------------------------------------------------------
# Segurança e Tokens (MUITO IMPORTANTE: Gere chaves únicas aleatórias)
# Execute no terminal: openssl rand -hex 32
# ------------------------------------------------------------------------------
JWT_SECRET=substitua_por_uma_chave_secreta_jwt_minimo_32_caracteres_aleatorios
COOKIE_SECRET=substitua_por_uma_chave_secreta_cookie_minimo_32_caracteres_aleatorios

# ------------------------------------------------------------------------------
# CORS - Origem permitida para o Frontend
# Se o frontend estiver em https://bateriasestrela.com.br, informe esse endereço
# Se tiver mais de uma origem separadas por vírgula, ou subdomínios
# ------------------------------------------------------------------------------
CORS_ORIGIN=https://bateriasestrela.com.br

# ------------------------------------------------------------------------------
# Armazenamento de Fotos e Mídias
# 'local' usa o volume persistente da VPS (/app/uploads)
# 's3' usa Cloudflare R2, AWS S3, Wasabi ou MinIO
# ------------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=/app/uploads

# Configurações opcionais caso utilize S3 / Cloudflare R2 em vez de disco local:
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=baterias-estrela-media
# S3_REGION=auto
# S3_ACCESS_KEY_ID=sua_access_key
# S3_SECRET_ACCESS_KEY=sua_secret_key
# S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# Provisionamento Inicial do Primeiro Administrador
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@bateriasestrela.com.br
ADMIN_PASSWORD=defina_sua_senha_mestre_do_admin
ADMIN_NAME=Diretoria Baterias Estrela
