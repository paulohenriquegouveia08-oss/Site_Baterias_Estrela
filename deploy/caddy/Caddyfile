# ==============================================================================
# Baterias Estrela - Configuração Caddy com HTTPS Automático
# ==============================================================================
# O Caddy provisiona e renova certificados Let's Encrypt automaticamente
# sem necessidade de rodar o Certbot.
# ==============================================================================

# Subdomínio da API
api.bateriasestrela.com.br {
    # Tamanho máximo de upload (fotos e planilhas)
    request_body {
        max_size 15MB
    }

    # Cabeçalhos de segurança
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    # Proxy reverso para o backend Fastify
    reverse_proxy 127.0.0.1:3333 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    # Compressão de respostas
    encode zstd gzip
}
