# Configurações do Servidor
PORT=3333
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Banco de Dados PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baterias_estrela?schema=public"

# Segurança e Autenticação
JWT_SECRET="chave_secreta_jwt_para_desenvolvimento_minimo_32_caracteres"
COOKIE_SECRET="chave_secreta_cookie_para_desenvolvimento_32_caracteres"

# Armazenamento de Arquivos e Fotos (driver: 'local' ou 's3')
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads

# Configurações opcionais para driver S3 / MinIO (se STORAGE_DRIVER=s3)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=baterias-estrela-media
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Administrador Inicial (usado apenas no comando `pnpm admin:create` ou seed)
INITIAL_ADMIN_EMAIL=admin@bateriasestrela.com.br
INITIAL_ADMIN_PASSWORD=MudeEstaSenha@2026!
INITIAL_ADMIN_NAME="Administrador Baterias Estrela"
